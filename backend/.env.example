# IMovies Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/imovies
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# JWT Secret for User Authentication
JWT_SECRET=imovies_super_secret_jwt_key_replace_in_production_min32chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173/imovies
APP_URL=http://localhost:5000/imovies

# Razorpay Payment Gateway Credentials (Optional: Leave empty for demo mode)
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# UPI Configuration (Google Pay / PhonePe)
UPI_MERCHANT_VPA=rachitbanke1@okhdfcbank
UPI_MERCHANT_NAME=Rachit Banke
PHONEPE_MERCHANT_VPA=rachitbanke1@okhdfcbank
PHONEPE_MERCHANT_NAME=Rachit Banke
